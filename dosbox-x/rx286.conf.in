# ============================================================================
# rx286 - dosbox-x/rx286.conf.in
# DOSBox-X as a 286 with an EGA, for the suites on a 286 core (roadmap M9).
#
# A template: tools/run-test --emulator dosbox-x fills in the placeholders.
# DOSBox-X boots its own DOS first; [autoexec] then boots the floppy image.
# docs/emulators.md lists how this machine differs from the AT and Bochs.
# ============================================================================

[sdl]
autolock = false

[dosbox]
machine = ega
# 1 MB: no extended memory, an AT without any (roadmap os-server.md P3)
memsize = 1
fastbioslogo = true
startbanner = false

[cpu]
core = normal
cputype = 286
fpu = 287
segment limits = true
double fault = true
reset on triple fault = true
allow lmsw to exit protected mode = false
cycles = max
# fast-forward: DOSBox-X keeps to real time, and the tests measure only the
# machine's time (os-server.md P15)
turbo = true
isapnpbios = false
apmbios = false

[keyboard]
aux = false

[serial]
serial1 = serialmouse
serial2 = @COM2@
serial3 = @COM3@
serial4 = disabled

[joystick]
joysticktype = 2axis

[parallel]
parallel1 = file append:@LPT1@ timeout:20
parallel2 = file append:@LPT2@ timeout:20

[dos]
xms = false
ems = false
umb = false

[autoexec]
imgmount a @IMAGE@ -t floppy
boot a:
