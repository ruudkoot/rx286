# ============================================================================
# rx286 - bochs/rx286.bochsrc.in
# The IBM PC/AT of docs/hardware.md, as Bochs 2.7 emulates it.
#
# A template: tools/bochs-run and tools/run-test fill in the placeholders for each
# run (the image, the serial log, the display). Bochs has no 80286 and no EGA;
# docs/emulators.md lists every difference from the AT.
# ============================================================================

# wx as the display needs wx as the configuration interface too (make run,
# make debugger); the tests run without a window, on textconfig and rfb.
config_interface: @CONFIG_INTERFACE@

# 640 KB of base memory and 3 MB above 1 MB: the kernel's objects and
# programs' segments live there (roadmap os-server.md P3, D18 B).
megs: 4
cpu: model=bx_generic, count=1, ips=4000000, reset_on_triple_fault=1
romimage: file=/usr/share/bochs/BIOS-bochs-legacy
vgaromimage: file=/usr/share/bochs/VGABIOS-lgpl-latest
vga: extension=none
pci: enabled=0

# A fixed start time (1989-01-01 00:00:00) and emulated time, so runs repeat;
# real time when a test talks to a modem on the host, so that its answers
# come in the ticks they would.
clock: sync=@CLOCK_SYNC@, time0=599616000

# Drive A: 1.2 MB 5.25", the boot disk; drive B: 360 KB 5.25" (roadmap D2).
# A test may take B's diskette out or write-protect it.
floppya: 1_2=@IMAGE@, status=inserted
floppyb: 360k=@FDB@, status=@FDB_STATUS@, write_protected=@FDB_PROTECTED@
boot: floppy
floppy_bootsig_check: disabled=0

# The fixed-disk controller with drive types 2 (20 MB) and 1 (10 MB); a test
# may leave the second out.
ata0: enabled=1, ioaddr1=0x1f0, ioaddr2=0x3f0, irq=14
ata0-master: type=disk, path=@HD0@, mode=flat, cylinders=615, heads=4, spt=17
ata0-slave: type=@HD1_TYPE@, path=@HD1@, mode=flat, cylinders=306, heads=4, spt=17
ata1: enabled=0
ata2: enabled=0
ata3: enabled=0

keyboard: type=at
# COM1: a Microsoft serial mouse, captured in a window with Ctrl+F10. COM2:
# the log of debug and test builds, or the modem of a release build (a
# test's peer, or nothing); COM3: the log when a test makes COM2 the modem.
# COM4 is not used (devices roadmap D1, D2).
mouse: type=serial, enabled=0, toggle=ctrl+f10
com1: enabled=1, mode=mouse
com2: enabled=1, @COM2@
com3: enabled=1, @COM3@
com4: enabled=1, mode=null
parport1: enabled=1, file=@LPT1@
parport2: enabled=@LPT2_ENABLED@, file=@LPT2@
speaker: enabled=1, mode=gui

# Debugging aids: magic breakpoints (xchg bx, bx), and the debugger's log.
magic_break: enabled=@MAGIC@
debugger_log: @DEBUGGER_LOG@
log: @LOG@
display_library: @DISPLAY@
