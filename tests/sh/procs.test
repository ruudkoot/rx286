# ps, kill, sleep and env as programs (roadmap os-server.md P12). (Pids:
# init 1, its children for the eight terminals 2 to 9, the shell on the
# first; then each command.) ps lists the first terminal's processes, -e
# all: the other terminals' children of init wait for Enter, the shell for
# its child, sleep in its call, and one stopped. kill sends SIGTERM, or the
# signal named; kill -l names them. env sets, empties, and runs a command
# found along PATH, or along /z, A's and C's /bin without one.
program: sh
install: C /BIN/SLEEP z-sleep.rx
install: C /BIN/PS z-ps.rx
install: C /BIN/KILL z-kill.rx
install: C /BIN/ENV z-env.rx
install: C /BIN/HEAD z-head.rx
keys: sleep 50 &\n{wait 10}ps\nkill 10\nps -e\nsleep 30 &\nkill -s STOP 14; ps\n
keys: kill -CONT 14; kill -9 14\nkill -l; kill -l 130; kill 999; kill -s NOPE 1; kill\n
keys: env -i A=1 B=2; env -i A=1 env; env -i A=1 A=2; env nothing; echo $?\n
keys: env | head -n 1; sleep x\n
timeout: 60
---
rx286, test build
/mnt/rx286$ sleep 50 &
[1] 10
/mnt/rx286$ ps
  PID  PPID  PGID   SID TTY  S NI COMMAND
    2     1     2     2 tty1 S 20 sh
   10     2    10     2 tty1 S 20 sleep
   11     2    11     2 tty1 R 20 ps
/mnt/rx286$ kill 10
[1] Done  sleep 50
/mnt/rx286$ ps -e
  PID  PPID  PGID   SID TTY  S NI COMMAND
    1     0     1     1 -    S 20 init
    2     1     2     2 tty1 S 20 sh
    3     1     3     3 tty2 S 20 init
    4     1     4     4 tty3 S 20 init
    5     1     5     5 tty4 S 20 init
    6     1     6     6 tty5 S 20 init
    7     1     7     7 tty6 S 20 init
    8     1     8     8 tty7 S 20 init
    9     1     9     9 tty8 S 20 init
   13     2    13     2 tty1 R 20 ps
/mnt/rx286$ sleep 30 &
[1] 14
/mnt/rx286$ kill -s STOP 14; ps
  PID  PPID  PGID   SID TTY  S NI COMMAND
    2     1     2     2 tty1 S 20 sh
   14     2    14     2 tty1 T 20 sleep
   16     2    16     2 tty1 R 20 ps
[1] Stopped  sleep 30
/mnt/rx286$ kill -CONT 14; kill -9 14
[1] Done  sleep 30
/mnt/rx286$ kill -l; kill -l 130; kill 999; kill -s NOPE 1; kill
