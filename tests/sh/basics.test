# The shell in C (roadmap os-server.md P9): init starts it from /z in the
# boot drive's directory, /a; a command, a listing in DOS's drive syntax,
# and the milestone's pipeline into a file and back.
program: sh
# DOSBox-X has no disk controller rx286 can use (docs/emulators.md).
emulators: bochs mame
keys: echo hello\nls c:/docs\nls c:/docs | wc -l > c:/n.txt\ncat c:/n.txt\n
---
rx286, test build
/a$ echo hello
hello
/a$ ls c:/docs
HELLO.TXT
PRINTME.TXT
/a$ ls c:/docs | wc -l > c:/n.txt
/a$ cat c:/n.txt
2
/a$
