# lp (roadmap os-server.md P9): a file to LPT1 through /dev/lpt1, and the
# standard input to LPT2. MAME's printers are not captured (docs/emulators.md).
program: sh
emulators: bochs
keys: echo one > /b/p.txt; lp /b/p.txt; echo two | lp -d lpt2\n
lpt1: one
lpt2: two
---
rx286, test build
/a$ echo one > /b/p.txt; lp /b/p.txt; echo two | lp -d lpt2
/a$
