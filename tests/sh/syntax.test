# The shell's syntax (roadmap os-server.md P9): quoting, variables and $?,
# lists, redirection of input, output and errors, cd (and to HOME) and pwd,
# aliases, a command not found, and a line recalled with Up. An alias is put
# in when its line is read, as POSIX has it: on its own line it is not there
# yet.
program: sh
# DOSBox-X has no disk controller rx286 can use (docs/emulators.md).
emulators: bochs mame
install: C /BIN/WC z-wc.rx
keys: echo 'a  b' "home: $HOME" \\$HOME\nX=1; echo $X $\{X}y\nexport X; set\n
keys: true && echo yes; false || echo no; false && echo never; echo $?\n
keys: nosuch; echo $?\necho one > /mnt/rx286b/t.txt; echo two >> /mnt/rx286b/t.txt; wc -l < /mnt/rx286b/t.txt\n
keys: cat /mnt/rx286b/nothing 2> /mnt/rx286b/err.txt; cat /mnt/rx286b/err.txt\ncd /mnt/rx286b; pwd; cd ..; pwd\n
keys: alias ll='ls /mnt/rx286c'; ll\n{up}\ncd; pwd\n
---
rx286, test build
/mnt/rx286$ echo 'a  b' "home: $HOME" \$HOME
a  b home: /mnt/a: $HOME
/mnt/rx286$ X=1; echo $X ${{X}}y
1 1y
/mnt/rx286$ export X; set
PATH=/z:/mnt/rx286c/bin
HOME=/mnt/a:
X=1
/mnt/rx286$ true && echo yes; false || echo no; false && echo never; echo $?
yes
no
1
/mnt/rx286$ nosuch; echo $?
sh: nosuch: no such file or directory
127
/mnt/rx286$ echo one > /mnt/rx286b/t.txt; echo two >> /mnt/rx286b/t.txt; wc -l < /mnt/rx286b/t.txt
2
/mnt/rx286$ cat /mnt/rx286b/nothing 2> /mnt/rx286b/err.txt; cat /mnt/rx286b/err.txt
/mnt/rx286b/nothing: no such file or directory
/mnt/rx286$ cd /mnt/rx286b; pwd; cd ..; pwd
/mnt/rx286b
/mnt
/mnt$ alias ll='ls /mnt/rx286c'; ll
sh: ll: no such file or directory
/mnt$ alias ll='ls /mnt/rx286c'; ll
readme.txt
docs
numbers.txt
bin
/mnt$ cd; pwd
/mnt/rx286
/mnt/rx286$
