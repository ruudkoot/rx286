# What P15's second, uncapped review of the shell and its commands found
# (roadmap os-server.md P15), second part: an empty expansion's status is
# 0; a missing command is a syntax error, found before anything runs;
# NAME=value with a redirection does both; ${ unclosed is an error, $1abc
# is $1 and abc; no alias for a word with a $ in it; a file's last line
# without its new line runs, without a prompt or an echo; cp refuses a
# directory before it makes the target; wc and rm say their usage; ^D at
# an empty prompt ends the shell, and init starts another.
program: sh
install: C /BIN/SLEEP z-sleep.rx
install: C /BIN/KILL z-kill.rx
install: C /BIN/CP z-cp.rx
install: C /BIN/MKDIR z-mkdir.rx
install: C /BIN/WC z-wc.rx
install: C /BIN/RM z-rm.rx
keys: false; $EMPTY; echo [$?]\necho a;;echo b\necho [$?]\n
keys: X=1 > /mnt/rx286b/f; echo $X; ls /mnt/rx286b/f\necho $\{HOME\necho $1abc\nalias e=echo; e$EMPTY hi\n
keys: cat > /mnt/rx286b/t\necho first\necho last{ctrl-d}{ctrl-d}sh < /mnt/rx286b/t > /mnt/rx286b/out; cat /mnt/rx286b/out\n
keys: mkdir /mnt/rx286b/dd; cp /mnt/rx286b/dd /mnt/rx286b/x; echo [$?]; ls /mnt/rx286b/x\n
keys: echo hi | wc -q; echo [$?]; rm; echo [$?]\n
keys: {ctrl-d}echo again\n
---
rx286, test build
/mnt/rx286$ false; $EMPTY; echo [$?]
[0]
/mnt/rx286$ echo a;;echo b
sh: a command is missing
/mnt/rx286$ echo [$?]
[2]
/mnt/rx286$ X=1 > /mnt/rx286b/f; echo $X; ls /mnt/rx286b/f
1
/mnt/rx286b/f
/mnt/rx286$ echo ${HOME
sh: a ${ is not closed
/mnt/rx286$ echo $1abc
abc
/mnt/rx286$ alias e=echo; e$EMPTY hi
sh: e: no such file or directory
/mnt/rx286$ cat > /mnt/rx286b/t
echo first
echo last/mnt/rx286$ sh < /mnt/rx286b/t > /mnt/rx286b/out; cat /mnt/rx286b/out
first
last
/mnt/rx286$ mkdir /mnt/rx286b/dd; cp /mnt/rx286b/dd /mnt/rx286b/x; echo [$?]; ls /mnt/rx286b/x
cp: /mnt/rx286b/dd: is a directory
[1]
/mnt/rx286b/x: no such file or directory
/mnt/rx286$ echo hi | wc -q; echo [$?]; rm; echo [$?]
usage: wc [-lwc] [FILE]...
[1]
usage: rm FILE...
[1]
/mnt/rx286$
/mnt/rx286$ echo again
again
/mnt/rx286$
