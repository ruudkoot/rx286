# ls -l on every drive (roadmap os-server.md P9): the root, a subdirectory,
# one file, and a directory of two clusters (B:\MANY: 42 entries of 32
# bytes, 1 KB clusters); the server's own /, /dev and /z.
program: sh
emulators: bochs mame
keys: ls -l /a; ls -l b:/; ls -l c:/docs C:/DOCS/HELLO.TXT; ls -l /d\n
keys: ls -l b:/many\nls / /dev /z\n
---
rx286, test build
/a$ ls -l /a; ls -l b:/; ls -l c:/docs C:/DOCS/HELLO.TXT; ls -l /d
-rw-r--r-- {image_size8} KERNEL.BIN
-rw-r--r--       79 README.TXT
-rw-r--r--     3136 FRAG.TXT
-rw-r--r--       50 PAD.TXT
drwxr-xr-x        0 MANY
c:/docs:
-rw-r--r--       21 HELLO.TXT
-rw-r--r--      161 PRINTME.TXT
-rw-r--r--       21 C:/DOCS/HELLO.TXT
-rw-r--r--      142 README.TXT
drwxr-xr-x        0 GAMES
/a$ ls -l b:/many
-rw-r--r--       29 FILE01.TXT
-rw-r--r--       29 FILE02.TXT
-rw-r--r--       29 FILE03.TXT
-rw-r--r--       29 FILE04.TXT
-rw-r--r--       29 FILE05.TXT
