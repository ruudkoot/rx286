-rw-r--r--       29 FILE14.TXT
-rw-r--r--       29 FILE15.TXT
-rw-r--r--       29 FILE16.TXT
-rw-r--r--       29 FILE17.TXT
-rw-r--r--       29 FILE18.TXT
-rw-r--r--       29 FILE19.TXT
-rw-r--r--       29 FILE20.TXT
-rw-r--r--       29 FILE21.TXT
-rw-r--r--       29 FILE22.TXT
-rw-r--r--       29 FILE23.TXT
-rw-r--r--       29 FILE24.TXT
-rw-r--r--       29 FILE25.TXT
-rw-r--r--       29 FILE26.TXT
-rw-r--r--       29 FILE27.TXT
-rw-r--r--       29 FILE28.TXT
-rw-r--r--       29 FILE29.TXT
-rw-r--r--       29 FILE30.TXT
-rw-r--r--       29 FILE31.TXT
-rw-r--r--       29 FILE32.TXT
-rw-r--r--       29 FILE33.TXT
-rw-r--r--       29 FILE34.TXT
