-rw-r--r--       29 FILE37.TXT
-rw-r--r--       29 FILE38.TXT
-rw-r--r--       29 FILE39.TXT
-rw-r--r--       29 FILE40.TXT
/a$ ls / /dev /z
/:
a
b
c
d
dev
z
/dev:
null
tty
lpt1
lpt2
speaker
joystick
mouse
com2
status
tty1
tty2
tty3
tty4
tty5
tty6
tty7
tty8
/z:
init
sh
echo
cat
ls
clock
counter
/a$
