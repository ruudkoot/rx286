# Eight terminals (roadmap os-server.md P11): init starts a shell on the
# first, and on each of the others once Enter is pressed there; Alt+F1 to
# F8 show them, and the keys go to the one shown. The log is the first
# terminal's; this TEST_SCREEN build's console driver puts each page Alt+Fn
# shows on the log. Each terminal has its own job control: cat reads on the
# second while ^C drops a line on the first. At the end eight shells run.
program: sh
define: TEST_SCREEN
keys: echo one\n{alt-f2}\necho two\ncat\n{alt-f1}abc{ctrl-c}echo three\n
keys: {alt-f2}hi\n{ctrl-d}{alt-f3}\n{alt-f4}\n{alt-f5}\n{alt-f6}\n{alt-f7}\n{alt-f8}\n
keys: {alt-f3}{alt-f4}{alt-f5}{alt-f6}{alt-f7}{alt-f8}{alt-f2}{alt-f1}
match: contains
---
/mnt/rx286$ echo one
one
screen 1: shown
screen 1 01: rx286 terminal 2: press Enter for a shell
screen 0: shown
screen 0 01: /mnt/rx286$ echo one
screen 0 02: one
screen 0 03: /mnt/rx286$
/mnt/rx286$ abc^C
/mnt/rx286$ echo three
three
screen 1: shown
screen 1 03: /mnt/rx286$ echo two
screen 1 04: two
screen 1 05: /mnt/rx286$ cat
screen 2: shown
screen 2 01: rx286 terminal 3: press Enter for a shell
screen 7: shown
screen 7 01: rx286 terminal 8: press Enter for a shell
screen 2: shown
screen 2 03: /mnt/rx286$
screen 3: shown
screen 3 03: /mnt/rx286$
screen 4: shown
screen 4 03: /mnt/rx286$
screen 5: shown
screen 5 03: /mnt/rx286$
screen 6: shown
screen 6 03: /mnt/rx286$
screen 7: shown
screen 7 03: /mnt/rx286$
screen 1: shown
screen 1 05: /mnt/rx286$ cat
screen 1 06: hi
screen 1 07: hi
screen 1 08: /mnt/rx286$
screen 0: shown
screen 0 03: /mnt/rx286$ abc^C
screen 0 06: /mnt/rx286$
