# The first commands as programs (roadmap os-server.md P9), on drive C
# since P12: mkdir, cp into a directory, mv, cat of two files, wc and its
# options, rm, rmdir, and their refusals. fsck.fat finds B sound after.
program: sh
install: C /BIN/CP z-cp.rx
install: C /BIN/MV z-mv.rx
install: C /BIN/RM z-rm.rx
install: C /BIN/MKDIR z-mkdir.rx
install: C /BIN/RMDIR z-rmdir.rx
install: C /BIN/WC z-wc.rx
keys: cd /mnt/rx286b; mkdir d; echo text > a.txt; cp a.txt d; mv d/a.txt d/b.txt; ls d\n
keys: cat a.txt d/b.txt | wc; wc -l -c a.txt\nrm d/b.txt; rmdir d; ls\n
keys: rmdir /mnt/rx286b/many; cp nothing x; mv a.txt /mnt/rx286c/a.txt\n
match: full
fsck: B
---
rx286, test build
/mnt/rx286$ cd /mnt/rx286b; mkdir d; echo text > a.txt; cp a.txt d; mv d/a.txt d/b.txt; ls d
b.txt
/mnt/rx286b$ cat a.txt d/b.txt | wc; wc -l -c a.txt
2 2 10
1 5 a.txt
/mnt/rx286b$ rm d/b.txt; rmdir d; ls
readme.txt
frag.txt
pad.txt
many
a.txt
/mnt/rx286b$ rmdir /mnt/rx286b/many; cp nothing x; mv a.txt /mnt/rx286c/a.txt
/mnt/rx286b/many: directory not empty
nothing: no such file or directory
a.txt: across drives
/mnt/rx286b$
