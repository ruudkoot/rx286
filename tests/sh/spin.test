# A program that spins holds neither the machine nor its terminal
# (roadmap os-server.md P12): the shell runs another in the background,
# and ^C, typed though nobody reads, ends it in the foreground. (It spins
# at the shell's priority: fg gives it the terminal within a few slices.
# The wait after `spin &` lets it say so before the next line is echoed;
# the kernel's trace of its start may fall inside the prompt on the log.)
program: sh
emulators: bochs mame
install: C /BIN/SPIN z-spin.rx
keys: spin &\n{wait 50}echo beside it\nfg\n{wait 50}{now ctrl-c}echo $?\n
match: contains
---
/mnt/rx286$ spin &
[1] 10
{...}Spinning; ^C ends it.
{...}echo beside it
beside it
/mnt/rx286$ fg
spin
^C
/mnt/rx286$ echo $?
130
