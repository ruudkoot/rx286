# The prefilled tables, the program's LDT among them, as the CPU sees them
# once loaded (Bochs' debugger at the end of pm_start). Code and data limits change with the code, so they
# are left out; everything else is checked.
emulators: bochs
break: pm_start.ready
debugger: info gdt 0 8
debugger: info ldt 0 7
debugger: info idt 0 0x30
debugger: sreg
---
