# Keys typed through the 8042 under every modifier: what the keyboard
# driver puts in its ring (scancode, ASCII), as a program reads them
# through the OS server (tests/programs/keys.asm; roadmap l4.md L8).
program: keys
keys: aA1!{caps}aA{caps}a{ctrl-c}{alt-x}\b\t\n\e{up}{f1}{del}
