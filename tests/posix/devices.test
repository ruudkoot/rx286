# The devices of /dev through their drivers (roadmap os-server.md P14):
# init starts tests/posix/devices.c (TEST_POSIX_DEVICES). Three tones the
# kernel's probe measures (TEST_SOUND), a rest, three tones refused; the
# game port (DOSBox-X emulates a centred stick); the mouse's state after
# its reset, answered through IRQ4; COM2 refused, the log in test builds;
# and three console writes of 2,048 bytes, across which the ticks keep pace
# with the RTC's seconds: the kernel lets the interrupts in between bytes.
program: idle
define: TEST_POSIX_DEVICES
define: TEST_SOUND
keys: {wait 250}{wait 250}{wait 250}{wait 250}{wait 250}{wait 250}
match: prefix
timeout: 60
---
