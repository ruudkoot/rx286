# The terminal's keys for processes (roadmap os-server.md P9): with no
# program the root builds (program: none), the keyboard driver signals the
# processes' notification, and tests/posix/keys.c reads keys from
# /dev/tty, an arrow as ESC [ A; then Ctrl+Break gives the child of the
# terminal's reader SIGINT. (Bytes are said last first.)
program: none
define: TEST_POSIX_KEYS
keys: ab\n{up}{wait 20}{ctrl-break}
match: contains
timeout: 120
---
keys: 1 bytes: 61
keys: 1 bytes: 62
keys: 1 bytes: 0D
keys: 3 bytes: 41 5B 1B
rx286: Ctrl+Break: SIGINT
keys: the child, at Ctrl+Break (SIGINT 2): 2
