# The processes' files (roadmap os-server.md P7): init starts
# tests/posix/files.c (TEST_POSIX_FILES), which writes and reads files on B,
# the 360 KB diskette, makes, lists and removes a directory, renames a file
# out of it, reads the server's own directories, shares a description by
# dup and fork, writes one file through two descriptions (P15: each took a
# chain of its own), and is refused what it may not do, a directory renamed
# into one inside it among them (P15: it was cut off), and (P15) gives
# entries of two directories side by side inode numbers of their own, and
# takes 13 names a ".." shortens to 12. After the run fsck.fat
# finds B sound, and mtools reads the files as the program left them.
# MAME's diskette takes the AT's time: a minute and a half of waiting for it.
program: idle
define: TEST_POSIX_FILES
keys: {wait 250}{wait 250}{wait 250}{wait 250}{wait 250}{wait 250}{wait 250}{wait 250}{wait 250}{wait 250}{wait 250}{wait 250}
keys: {wait 250}{wait 250}{wait 250}{wait 250}{wait 250}{wait 250}
match: contains
timeout: 300
emulators: bochs mame
fsck: B
file: B /MOVED.TXT inner\n
file: B /NEW.TXT hello, files\nmore\n
file: B /SHARED.TXT child,parent\n
file: B /TWO.TXT first\nsecond\n
---
files: make /b/new.txt (3): 3
files: write 13 bytes (13): 13
files: close (0): 0
files: read it back in capitals: 13 bytes, the same: yes
files: write 5000 bytes over five clusters (5000): 5000
files: its size (5000): 5000, a file: yes
files: lseek to 4090 (4090): 4090
files: 20 bytes from there: 20, right
files: lseek past its end (5000): 5000
files: read at the end (0): 0
files: appended to (18): 18
files: mkdir /b/dir (0): 0
files: mkdir it again (-1, EEXIST 17): -1, errno 17
files: chdir to it (0): 0
files: getcwd: /b/DIR
files: . holds: . .. INNER.TXT
files: rmdir it, not empty (-1, ENOTEMPTY 39): -1, errno 39
files: rename the file out of it (0): 0
files: stat the old name (-1, ENOENT 2): -1, errno 2
files: rmdir it, now empty (0): 0
files: unlink big.dat (0): 0
files: / holds: a b c d dev z
files: /dev holds: null tty lpt1 lpt2
files: /z holds: init files
files: /dev/null takes 7 bytes (7): 7
files: open no file (-1, ENOENT 2): -1, errno 2
files: write a file of /z (-1, EROFS 30): -1, errno 30
files: open / to write (-1, EISDIR 21): -1, errno 21
files: rename to another drive (-1, EXDEV 18): -1, errno 18
files: a name past 8.3 (-1, ENAMETOOLONG 36): -1, errno 36
files: lseek the console (-1, ESPIPE 29): -1, errno 29
files: close no descriptor (-1, EBADF 9): -1, errno 9
files: dup (4): 4
files: F_GETFD (0): 0
files: F_GETFD after F_SETFD (1): 1
files: a description shared by fork and dup: one offset
files: two descriptions of one file, both written: one file
files: a write past the end: 3002 bytes, the hole zeros: yes
files: a write past what B holds (-1, EFBIG 27): -1, errno 27
files: and the file as it was (3002): 3002
files: rename a directory into its own (-1, EINVAL 22): -1, errno 22
files: into itself (-1, EINVAL 22): -1, errno 22
files: lseek near 64 KB (65531 65534 65534): 65531 65534 65534
files: stat and fstat of it open, 100 written (100 100): 100 100
files: a create with no descriptor left (-1, EMFILE 24): -1, errno 24
files: and no file made (-1, ENOENT 2): -1, errno 2
files: a file's name and a slash (-1, ENOTDIR 20): -1, errno 20
files: a new name and a slash, made (-1, EISDIR 21): -1, errno 21
files: a new name made as a directory (-1, ENOTDIR 20): -1, errno 20
files: and no file made (-1, ENOENT 2): -1, errno 2
files: rename my directory (0): 0
files: getcwd after it (/b/F): /b/F
files: rmdir my directory (-1, EBUSY 16): -1, errno 16
files: rmdir . (-1, EINVAL 22): -1, errno 22
files: rmdir it once I left it (0): 0
files: two files' inodes differ (1): 1
files: readdir's d_ino is stat's (1): 1
files: 13 names, then 12 ..: /b (0): 0
files: 13 names (-1, ENAMETOOLONG 36): -1, errno 36
files: a path of 255 bytes, its zero the 256th (0): 0
files: of 256 (-1, ENAMETOOLONG 36): -1, errno 36
files: a file renamed to a name and a slash (-1, ENOTDIR 20): -1, errno 20
files: getdents with room for less than a record (-1, EINVAL 22): -1, errno 22
files: getdents of /dev past 64 K names (0): 0
files: readdir's . and .. are their directories' inodes (2): 2
files: a file made in /z (-1, EROFS 30): -1, errno 30
files: a directory made in / (-1, EROFS 30): -1, errno 30
files: lseek past 2 GB (-1, EOVERFLOW 75): -1, 75
files: open with access mode 3 (-1, EINVAL 22): -1, errno 22
files: getcwd with no room (NULL, EINVAL 22): NULL, 22
files: a rename that would take my directory past 12 names (-1, ENAMETOOLONG 36): -1, errno 36
files: done
