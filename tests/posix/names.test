# Names on a volume, case-sensitive (roadmap disk-scheduler.md M1, D19;
# tests/posix/names.c): a.txt is A.TXT on B's image and a.txt in a listing;
# A.TXT, Docs, /dev/NULL and /B are refused or not found; DOS's b: and B:
# both name drive B. DOSBox-X has no diskette controller (docs/emulators.md).
program: idle
define: TEST_POSIX_NAMES
keys: {wait 250}{wait 250}{wait 250}{wait 250}{wait 250}{wait 250}{wait 250}{wait 250}
match: contains
file: B /A.TXT names\n
timeout: 120
emulators: bochs mame
---
names: a.txt made (3): 3
names: written (6): 6
names: closed (0): 0
names: a.txt listed (1): 1
names: A.TXT not listed (0): 0
names: A.TXT opened (-1, EINVAL 22): -1, errno 22
names: Docs made (-1, EINVAL 22): -1, errno 22
names: readme.txt, the disk's README.TXT (0): 0
names: /dev/NULL (-1, ENOENT 2): -1, errno 2
names: /dev/null (3): 3
names: /B/readme.txt (-1, ENOENT 2): -1, errno 2
names: b:/readme.txt (0): 0
names: B:/readme.txt (0): 0
names: b:/README.TXT (-1, EINVAL 22): -1, errno 22
names: done
