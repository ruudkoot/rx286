# type: a small file, a file in two pieces (B:\FRAG.TXT: clusters 3-4 and
# 6-7), and a file of four 8 KB clusters (C:\NUMBERS.TXT), through the FAT.
program: shell
keys: type c:\\docs\\hello.txt\ntype b:frag.txt\ntype c:\\numbers.txt\n
match: contains
timeout: 120
emulators: bochs mame
---
A:\>type c:\docs\hello.txt
Hello from C:\DOCS.
A:\>type b:frag.txt
line 01 of FRAG.TXT, a file in two pieces on B:
line 32 of FRAG.TXT, a file in two pieces on B:
line 33 of FRAG.TXT, a file in two pieces on B:
line 64 of FRAG.TXT, a file in two pieces on B:
A:\>type c:\numbers.txt
line 0001 of C:\NUMBERS.TXT
line 0500 of C:\NUMBERS.TXT
line 1000 of C:\NUMBERS.TXT
A:\>
