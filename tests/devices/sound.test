# beep and play (roadmap os-server.md P12): /dev/speaker's tones, every
# note measured by the kernel's probe (TEST_SOUND), the tune's rest silent.
program: sh
define: TEST_SOUND
install: C /BIN/BEEP z-beep.rx
install: C /BIN/PLAY z-play.rx
keys: beep\nplay\n
timeout: 60
---
rx286, test build
/mnt/rx286$ beep
probe: the speaker sounds at the frequency asked
probe: silent
/mnt/rx286$ play
probe: the speaker sounds at the frequency asked
probe: silent
probe: the speaker sounds at the frequency asked
probe: silent
probe: the speaker sounds at the frequency asked
probe: silent
probe: the speaker sounds at the frequency asked
probe: silent
probe: the speaker sounds at the frequency asked
probe: silent
probe: the speaker sounds at the frequency asked
probe: silent
probe: silent
probe: the speaker sounds at the frequency asked
probe: silent
probe: the speaker sounds at the frequency asked
probe: silent
probe: the speaker sounds at the frequency asked
probe: silent
probe: the speaker sounds at the frequency asked
probe: silent
probe: the speaker sounds at the frequency asked
probe: silent
probe: the speaker sounds at the frequency asked
probe: silent
/mnt/rx286$
