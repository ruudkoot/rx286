# The line editor: Backspace, Esc, Up for the last line, an empty line, an
# unknown command, and a line longer than the editor takes (70 characters).
program: shell
keys: echo abX\b\n{up}\nxyz\e\n   \nfoo bar\n
keys: echo 123456789012345678901234567890123456789012345678901234567890123456789\n
---
rx286, test build
rx286 shell: type help for the commands
rx286> echo ab
ab
rx286> echo ab
ab
rx286>
rx286>
rx286> foo bar
unknown command: foo; type help
rx286> echo 12345678901234567890123456789012345678901234567890123456789012345
12345678901234567890123456789012345678901234567890123456789012345
rx286>
