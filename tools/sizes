#!/usr/bin/env python3
# ============================================================================
# rx286 - tools/sizes
# Each segment of a build against its room in src/include/layout.inc, from
# the NASM map files. Warns at 90% full.
#
#   tools/sizes build/release
# ============================================================================

import os
import re
import sys

import rxlib

L = rxlib.LAYOUT
# (binary, section or the symbol that ends its code, label, room)
ROOMS = [
    ('boot-sector', 'boot_sector_end', 'boot sector (BPB and code)', 510),
    ('boot-loader', 'loader_end', 'boot loader', L['LOADER_SECTORS'] * L['SECTOR_SIZE']),
    ('kernel', 'entry', 'kernel: real-mode entry', L['ENTRY_ROOM']),
    ('kernel', 'ktext', 'kernel: code', L['KTEXT_ROOM']),
    ('kernel', 'kdata', 'kernel: data', L['KDATA_ROOM']),
    ('root', 'utext', 'root: code', L['UTEXT_ROOM']),
    ('root', 'udata', 'root: data', L['UDATA_ROOM']),
    ('user', 'utext', 'program: code', L['UTEXT_ROOM']),
    ('user', 'udata', 'program: data', L['UDATA_ROOM']),
    ('counter', 'ctext', 'counter: code', L['CTEXT_ROOM']),
    ('counter', 'cdata', 'counter: data', L['CDATA_ROOM']),
]


def section_lengths(path):
    lengths = {}
    total = 0
    for line in open(path, encoding='utf-8', errors='replace'):
        m = re.match(r'^\s*([0-9A-F]+)\s+([0-9A-F]+)\s+([0-9A-F]+)\s+([0-9A-F]{8})\s+'
                     r'(progbits|nobits)\s+(\S+)', line)
        if m:
            lengths[m.group(6)] = int(m.group(4), 16)
            total += int(m.group(4), 16)
    return lengths, total


def main(build):
    print('%-26s %7s %7s %5s' % ('segment', 'used', 'room', 'full'))
    warn = False
    for binary, section, label, room in ROOMS:
        path = os.path.join(build, binary + '.map')
        if not os.path.exists(path):
            continue
        lengths, total = section_lengths(path)
        if section.endswith('_end'):        # a symbol: its offset is the size used
            used = rxlib.symbol_offsets(path).get(section)
            if used is not None and binary == 'boot-sector':
                used -= L['BOOT_SECTOR_PHYS']
            elif used is not None:
                used -= L['LOADER_PHYS']
        else:
            used = lengths.get(section)
        if used is None:
            continue
        full = 100.0 * used / room
        flag = '  <- over 90%' if full > 90 else ''
        warn = warn or bool(flag)
        print('%-26s %7d %7d %4.0f%%%s' % (label, used, room, full, flag))
    image = os.path.join(build, 'image.bin')
    if os.path.exists(image):
        used, room = os.path.getsize(image), L['IMAGE_MAX']
        full = 100.0 * used / room
        flag = '  <- over 90%' if full > 90 else ''
        print('%-26s %7d %7d %4.0f%%%s' % ('boot image (KERNEL.BIN)', used, room, full, flag))
    return 0


if __name__ == '__main__':
    if len(sys.argv) != 2:
        sys.exit('usage: sizes BUILD_DIR')
    sys.exit(main(sys.argv[1]))
