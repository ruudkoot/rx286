#!/usr/bin/env python3
# ============================================================================
# rx286 - tools/lint
# Holds the sources to docs/style.md: the assembly, and the C (roadmap
# os-server.md P1, D22).
#
#   tools/lint                every source of src/, tests/programs/, tests/unit/
#   tools/lint FILE...
#
# Rules for C (.c, .h):
#   header    the file starts with the banner and " * rx286 - <its path>"
#   function  a function's definition follows a comment
#   compiler  no compiler's own word (__far, __declspec, __attribute__,
#             #pragma aux, asm, ...) outside src/include/rx/compiler.h
#   layout    as for assembly
# Rules for assembly:
#   header    the file starts with the banner and "; rx286 - <its path>"
#   cpu       a file that includes build.inc (a top-level source) says `cpu 286`
#   routine   in code, every label that is not local (.x) follows a routine
#             header that names it, with In:, Out: and Destroys: (data labels
#             have no colon; a label ending in _start or _end that no code
#             follows marks a place, not a routine)
#   port      `in`, `out` and `mov dx` name their port with a constant
#   layout    no tabs, no trailing spaces, at most 100 characters a line
# ============================================================================

import glob
import os
import re
import sys

import rxlib

ROOT = rxlib.ROOT
CODE_SECTIONS = {'entry', 'ktext', 'utext', '.text'}
COMPILER_H = os.path.join(ROOT, 'src', 'include', 'rx', 'compiler.h')
COMPILER_WORDS = re.compile(r'\b(__far|__near|__huge|__declspec|__attribute__|__watcall|__cdecl|'
                            r'__interrupt|__pascal|_asm|__asm__|__asm|asm)\b|#\s*pragma\s+aux')
C_FUNCTION = re.compile(r'^[A-Za-z_][\w \t*]*\b([A-Za-z_]\w*)\s*\([^;]*\)\s*$')


def data_includes():
    """Files kernel.asm includes while in a data section: lint reads them as
    data from their first line."""
    files = set()
    section = None
    path = os.path.join(ROOT, 'src', 'kernel', 'kernel.asm')
    for line in open(path, encoding='utf-8'):
        m = re.match(r'^\s*section\s+(\S+)', line)
        if m:
            section = m.group(1)
        m = re.match(r'^\s*%include\s+"([^"]+)"', line)
        if m and section is not None and section not in CODE_SECTIONS:
            files.add(os.path.join(ROOT, 'src', 'kernel', m.group(1)))
    return files


DATA_FILES = data_includes()
LABEL = re.compile(r'^([A-Za-z_][A-Za-z0-9_]*):')
PORT_NUMBER = re.compile(
    r'^\s*(?:[A-Za-z_.][\w.]*:)?\s*(?:out\s+(\d\w*)\s*,|in\s+\w+\s*,\s*(\d\w*)\s*(?:;|$))',
    re.I)
DX_NUMBER = re.compile(r'^\s*(?:[A-Za-z_.][\w.]*:)?\s*mov\s+dx\s*,\s*\d\w*\s*(?:;|$)', re.I)
DX_PORT = re.compile(r'^\s*(?:[A-Za-z_.][\w.]*:)?\s*(?:in\s+\w+\s*,\s*dx|out\s+dx\s*,)', re.I)
DIRECTIVE = re.compile(r'^\s*(?:times|db|dw|dd|dq|dt|incbin|section|\[section|%|[A-Za-z_][\w]*:|'
                       r'[A-Za-z_][\w]*\s+(?:db|dw|dd|equ|times))', re.I)


def is_marker(label, lines, n):
    """A label that marks a place (it ends in _start or _end and no code
    follows it), not a routine."""
    if not label.endswith(('_start', '_end')):
        return False
    for line in lines[n:]:
        text = line.split(';', 1)[0].strip()
        if text:
            return bool(DIRECTIVE.match(text))
    return True


def lint_c(path):
    problems = []
    rel = os.path.relpath(path, ROOT)
    lines = open(path, encoding='utf-8').read().split('\n')

    def report(n, rule, text):
        problems.append('%s:%d: %s: %s' % (rel, n, rule, text))

    if len(lines) < 2 or not lines[0].startswith('/* ====') or \
            lines[1].strip() != '* rx286 - ' + rel:
        report(1, 'header', 'the file must start with the banner and " * rx286 - %s"' % rel)
    # the code without its comments and strings, line for line
    text = '\n'.join(lines)
    code_text = re.sub(r'/\*.*?\*/|//[^\n]*|"(?:[^"\\\n]|\\.)*"',
                       lambda m: re.sub(r'[^\n]', ' ', m.group(0)), text, flags=re.S)
    code_lines = code_text.split('\n')
    for n, line in enumerate(lines, 1):
        if '\t' in line:
            report(n, 'layout', 'a tab')
        if line != line.rstrip():
            report(n, 'layout', 'trailing spaces')
        if len(line) > 100:
            report(n, 'layout', 'longer than 100 characters')
        code = code_lines[n - 1]
        if path != COMPILER_H and COMPILER_WORDS.search(code):
            report(n, 'compiler', 'a compiler\'s own word outside compiler.h: ' + line.strip())
        m = C_FUNCTION.match(line)
        if m and n < len(lines) and lines[n].strip() == '{' and \
                not line.startswith(('if', 'for', 'while', 'switch', 'else', 'do')):
            k = n - 2
            while k >= 0 and lines[k].strip() == '':
                k -= 1
            if k < 0 or not lines[k].rstrip().endswith('*/'):
                report(n, 'function', '%s needs a comment before it' % m.group(1))
    return problems


def lint(path):
    if path.endswith(('.c', '.h')):
        return lint_c(path)
    problems = []
    rel = os.path.relpath(path, ROOT)
    lines = open(path, encoding='utf-8').read().split('\n')

    def report(n, rule, text):
        problems.append('%s:%d: %s: %s' % (rel, n, rule, text))

    if len(lines) < 2 or not lines[0].startswith('; ====') or \
            lines[1].strip() != '; rx286 - ' + rel:
        report(1, 'header', 'the file must start with the banner and "; rx286 - %s"' % rel)
    text = '\n'.join(lines)
    if re.search(r'^%include "build.inc"', text, re.M) and \
            not re.search(r'^\s*cpu 286\b', text, re.M):
        report(1, 'cpu', 'a top-level source must say `cpu 286`')

    section = 'kdata' if path in DATA_FILES else '.text'
    saved = []
    for n, line in enumerate(lines, 1):
        if '\t' in line:
            report(n, 'layout', 'a tab')
        if line != line.rstrip():
            report(n, 'layout', 'trailing spaces')
        if len(line) > 100:
            report(n, 'layout', 'longer than 100 characters')
        m = re.match(r'^\s*section\s+(\S+)', line)
        if m:
            section = m.group(1)
        m = re.match(r'^\s*(code|data|bss)_section\b', line)     # cabi.inc's
        if m:
            section = '.text' if m.group(1) == 'code' else 'kdata'
        if re.match(r'^\s*begin_[ku]data\b', line):
            saved.append(section)
            section = 'kdata'
        elif re.match(r'^\s*end_[ku]data\b', line) and saved:
            section = saved.pop()
        if PORT_NUMBER.match(line):
            report(n, 'port', 'name the port with a constant: ' + line.strip())
        if DX_NUMBER.match(line):
            following = next((l for l in lines[n:] if l.split(';', 1)[0].strip()), '')
            if DX_PORT.match(following):
                report(n, 'port', 'name the port with a constant: ' + line.strip())
        m = LABEL.match(line)
        if m and section in CODE_SECTIONS and not is_marker(m.group(1), lines, n):
            k = n - 2
            while k >= 0 and lines[k].strip() == '':
                k -= 1
            block = []
            while k >= 0 and lines[k].lstrip().startswith(';'):
                block.append(lines[k])
                k -= 1
            header = '\n'.join(block)
            if not all(word in header for word in ('In:', 'Out:', 'Destroys:')):
                report(n, 'routine', '%s needs a header with In:, Out: and Destroys:'
                       % m.group(1))
            else:
                named = re.findall(r'^;\s+([A-Za-z_][\w]*)\s+-\s', header, re.M)
                if m.group(1) not in named:
                    report(n, 'routine', "%s's header names %s" % (m.group(1), named or 'nothing'))
    return problems


def main(args):
    paths = args or sorted(
        glob.glob(os.path.join(ROOT, 'src', '**', '*.asm'), recursive=True) +
        glob.glob(os.path.join(ROOT, 'src', '**', '*.inc'), recursive=True) +
        glob.glob(os.path.join(ROOT, 'src', '**', '*.c'), recursive=True) +
        glob.glob(os.path.join(ROOT, 'src', '**', '*.h'), recursive=True) +
        glob.glob(os.path.join(ROOT, 'tests', 'programs', '*.asm')) +
        glob.glob(os.path.join(ROOT, 'tests', 'programs', '*.c')) +
        glob.glob(os.path.join(ROOT, 'tests', 'unit', '*.asm')) +
        glob.glob(os.path.join(ROOT, 'tests', 'unit', 'c', '*.[ch]')))
    problems = []
    for p in paths:
        problems += lint(os.path.abspath(p))
    for p in problems:
        print(p)
    print('lint: %d file(s), %d problem(s)' % (len(paths), len(problems)))
    return 1 if problems else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
