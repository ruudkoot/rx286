#!/usr/bin/env python3
# ============================================================================
# rx286 - tools/check-286
# Finds 386 (and later) instructions in NASM listings, which NASM's `cpu 286`
# lets through (roadmap E4, E10) and Bochs then runs without a word.
#
#   tools/check-286 build/*/*.lst build/*/c/*/*/*.dis
#   tools/check-286 --self-test       assembles tools/testdata/slips.asm and
#                                     checks that exactly its SLIP lines fail,
#                                     and that the C checks find their slips
#
# C's code comes as disassembly (.dis, c.mk; roadmap os-server.md P1): Open
# Watcom's wdis or gcc-ia16's objdump. There it fails on the same, and on a
# LOCK prefix (F0h) too: LOCK is #GP at ring 3 on a 286 (os-server.md W4,
# X10), so no compiler may emit it, though NASM sources may on purpose.
# wdis's dumps of data segments are passed over: their bytes are no code.
#
# It reads listings, not binaries, so data is never taken for code. For each
# instruction it fails on:
#   - a 66h, 67h, 64h or 65h byte anywhere among its prefixes
#     (operand size, address size, FS, GS);
#   - 8Ch or 8Eh with FS, GS or no segment register (6, 7) in the ModRM
#     byte, and 8Eh with CS (#UD on a 286);
#   - a 0Fh opcode outside the 286's: 00h-03h, 05h (LOADALL), 06h (CLTS);
#     of 0F 00, /0-/5 alone (SLDT to VERW); of 0F 01, the memory forms of
#     /0-/3 (SGDT to LIDT) and /4, /6 (SMSW, LMSW): its register forms are
#     the 486's and later's (INVLPG, MONITOR, RDTSCP...);
#   - an ESC (D8h-DFh) that is not the 287's: its register forms as Intel's
#     287 lists them (FPU_287), its memory forms less the reserved ones and
#     SSE3's FISTTP (D9 /1, DB /1, /4, /6, DD /1, /5, DF /1); so the 387's
#     (FUCOM..., FPREM1, FSIN, FCOS, FSINCOS), the P6's (FCMOVcc, FCOMI...)
#     and FFREEP;
#   - F1h (the 386's ICEBP).
# Nor does it pass a listing that hides lines from it ([list -]), and it
# reads the bytes of `align N, instruction`, which are that instruction's.
# ============================================================================

import os
import re
import subprocess
import sys
import tempfile

PREFIXES = {0xF0, 0xF2, 0xF3, 0x26, 0x2E, 0x36, 0x3E, 0x64, 0x65, 0x66, 0x67}
FORBIDDEN_PREFIXES = {0x64: 'FS override', 0x65: 'GS override',
                      0x66: 'operand-size prefix', 0x67: 'address-size prefix'}
OPCODES_0F_286 = {0x00, 0x01, 0x02, 0x03, 0x05, 0x06}
FPU_387 = {(0xD9, 0xF5): 'FPREM1', (0xD9, 0xFB): 'FSINCOS', (0xD9, 0xFE): 'FSIN',
           (0xD9, 0xFF): 'FCOS', (0xDA, 0xE9): 'FUCOMPP'}


def spans(*ranges):
    out = set()
    for r in ranges:
        lo, hi = r if isinstance(r, tuple) else (r, r)
        out.update(range(lo, hi + 1))
    return out


# The 287's register forms (mod 3), by ESC opcode: Intel, 80287 data sheet
# and iAPX 286 Programmer's Reference, the 287's instruction set. FENI and
# FDISI (DB E0, E1) are the 8087's, which a 287 takes as no operation.
FPU_287 = {0xD8: spans((0xC0, 0xFF)),
           0xD9: spans((0xC0, 0xD0), 0xE0, 0xE1, 0xE4, 0xE5, (0xE8, 0xEE), (0xF0, 0xF4),
                       (0xF6, 0xFA), 0xFC, 0xFD),
           0xDA: set(),
           0xDB: spans((0xE0, 0xE4)),
           0xDC: spans((0xC0, 0xCF), (0xE0, 0xFF)),
           0xDD: spans((0xC0, 0xC7), (0xD0, 0xDF)),
           0xDE: spans((0xC0, 0xCF), 0xD9, (0xE0, 0xFF)),
           0xDF: {0xE0}}
# Its memory forms: all but these (ESC, reg), reserved or SSE3's FISTTP
FPU_MEMORY_NOT_287 = {(0xD9, 1), (0xDB, 1), (0xDB, 4), (0xDB, 6), (0xDD, 1), (0xDD, 5),
                      (0xDF, 1)}
LIST_OFF = re.compile(r'^\s*\d+\s+\[\s*list\s+-\s*\]', re.I)
DATA = {'db', 'dw', 'dd', 'dq', 'dt', 'do', 'incbin', 'resb', 'resw', 'resd', 'align',
        'alignb', 'equ', 'section', 'segment', 'org', 'bits', 'cpu', 'istruc', 'iend',
        'at', 'struc', 'endstruc'}

LINE = re.compile(r'^\s*(\d+)\s+([0-9A-F]{8})\s+([0-9A-F()\[\]]+)(-?)(?:<rep [0-9A-Fa-f]+h>)?\s*(.*)$')


def instruction_bytes(text):
    return [int(text[i:i + 2], 16) for i in range(0, len(text) - 1, 2)]


def mnemonic(source):
    source = re.sub(r'^\s*<\d+>', '', source)          # a macro's expansion
    source = source.split(';', 1)[0].strip()
    source = re.sub(r'^[A-Za-z_.$?@][\w.$?@]*:\s*', '', source)   # a label
    words = source.split()
    if not words:
        return None
    if len(words) > 1 and words[1].lower() in DATA | {'times'}:   # "label db ..."
        return words[1].lower() if words[1].lower() in DATA else 'db'
    if words[0].lower() == 'times':
        rest = re.sub(r'^times\s+(\([^)]*\)|\S+)\s*', '', source, flags=re.I).split()
        return rest[0].lower() if rest else None
    return words[0].lower()


def check_instruction(code):
    """A reason this instruction is not the 286's, or None."""
    i = 0
    # Prefixes, and WAIT (9Bh), which NASM puts before an ESC and its
    # prefixes: `fstcw [fs:bx]` is 9B 64 D9 3F.
    while i < len(code) and (code[i] in PREFIXES or code[i] == 0x9B and i + 1 < len(code)):
        if code[i] in FORBIDDEN_PREFIXES:
            return FORBIDDEN_PREFIXES[code[i]]
        i += 1
    if i >= len(code):
        return None
    op = code[i]
    nxt = code[i + 1] if i + 1 < len(code) else None
    if op == 0x0F:
        if nxt is None or nxt not in OPCODES_0F_286:
            return 'opcode 0F %s' % ('%02X' % nxt if nxt is not None else '??')
        if nxt in (0x00, 0x01):
            modrm = code[i + 2] if i + 2 < len(code) else None
            if modrm is None:
                return 'opcode 0F %02X without its ModRM byte' % nxt
            mod, reg = modrm >> 6, (modrm >> 3) & 7
            if nxt == 0x00 and reg > 5 or \
                    nxt == 0x01 and (reg in (5, 7) or reg < 4 and mod == 3):
                return 'opcode 0F %02X %02X' % (nxt, modrm)
    elif op in (0x8C, 0x8E) and nxt is not None and ((nxt >> 3) & 7) in (4, 5):
        return 'FS or GS'
    elif op in (0x8C, 0x8E) and nxt is not None and ((nxt >> 3) & 7) in (6, 7):
        return 'no such segment register'
    elif op == 0x8E and nxt is not None and ((nxt >> 3) & 7) == 1:
        return 'MOV CS'
    elif op == 0xF1:
        return 'ICEBP'
    elif (op, nxt) in FPU_387:
        return FPU_387[(op, nxt)]
    elif op == 0xDD and nxt is not None and 0xE0 <= nxt <= 0xEF:
        return 'FUCOM/FUCOMP'
    elif 0xD8 <= op <= 0xDF and nxt is not None:
        if nxt >= 0xC0 and nxt not in FPU_287[op]:
            return 'ESC %02X %02X: no 287 instruction' % (op, nxt)
        if nxt < 0xC0 and (op, (nxt >> 3) & 7) in FPU_MEMORY_NOT_287:
            return 'ESC %02X /%d: no 287 instruction' % (op, (nxt >> 3) & 7)
    return None


def check_listing(path):
    problems = []
    continued = False
    for n, raw in enumerate(open(path, encoding='latin-1'), 1):
        if LIST_OFF.match(raw):
            problems.append((path, int(raw.split()[0]), '--------', '[list -] hides lines',
                             raw.split(None, 1)[1].strip()))
        m = LINE.match(raw.rstrip('\n'))
        if not m:
            continued = False
            continue
        lineno, addr, hexbytes, dash, source = m.groups()
        # A byte field that ends in '-' goes on in the next line: that line
        # holds more of the same bytes, not an instruction of its own. Every
        # other line is checked, each expansion of a macro included.
        was_continued, continued = continued, dash == '-'
        if was_continued:
            continue
        word = mnemonic(source)
        if word == 'align':
            # align N, fill: the fill's bytes, an instruction's unless data
            fill = source.split(';', 1)[0].partition(',')[2].split()
            if fill and fill[0].lower() in DATA:
                continue
        elif word is None or word in DATA or word.startswith('%'):
            continue
        hexbytes = re.sub(r'[()\[\]]', '', hexbytes)
        reason = check_instruction(instruction_bytes(hexbytes))
        if reason:
            problems.append((path, int(lineno), addr, reason, source.strip()))
    return problems


WDIS = re.compile(r'^([0-9A-F]{4,8})\s+((?:[0-9A-F]{2} )+)\s*(\S+)')
OBJDUMP = re.compile(r'^\s*([0-9a-f]+):\s+((?:[0-9a-f]{2} )+)\s*(\S+)')
DATA_MNEMONICS = {'db', 'dw', 'dd', '.byte', '.word', '.long', '(bad)'}


def check_disassembly(path):
    """A C object's disassembly: each instruction's bytes, LOCK refused too.
    wdis dumps the data segments (CONST, _DATA) as bytes and their text,
    which are no instructions: only its code segments (_TEXT) are read."""
    problems = []
    code_segment = True
    for n, raw in enumerate(open(path, encoding='latin-1'), 1):
        if raw.startswith('Segment: '):
            code_segment = raw.split()[1].endswith('TEXT')
            continue
        m = WDIS.match(raw) or OBJDUMP.match(raw)
        if not code_segment or not m or m.group(3).lower() in DATA_MNEMONICS:
            continue
        code = instruction_bytes(m.group(2).replace(' ', ''))
        reason = check_instruction(code)
        i = 0
        while not reason and i < len(code) and code[i] in PREFIXES:
            if code[i] == 0xF0:
                reason = 'LOCK (#GP at ring 3)'
            i += 1
        if reason:
            problems.append((path, n, m.group(1), reason, raw.strip()))
    return problems


DIS_SELF_TEST = '''\
0000  55                push            bp
0001  F0 FF 07          lock inc        word ptr [bx]
0004  66 50             push            eax
0006  0F 84 10 00       je              L$1
000A  DW    0004
   0:\t55                   \tpush   %bp
   1:\tf0 ff 07             \tlock incw (%bx)
Segment: CONST WORD USE16 00000010 bytes
0000  66 65 64 20 75 70 00                            fed up.
Segment: _TEXT BYTE USE16 00000002 bytes
0000  66 50             push            eax
0002  DA C1             fcmovb          st,st(1)
0004  0F 01 F9          rdtscp
0007  DF E0             fstsw           ax
'''


def self_test():
    here = os.path.dirname(os.path.abspath(__file__))
    src = os.path.join(here, 'testdata', 'slips.asm')
    with tempfile.TemporaryDirectory() as tmp:
        lst = os.path.join(tmp, 'slips.lst')
        subprocess.run(['nasm', '-f', 'bin', '-w-all', '-o', os.devnull, '-l', lst, src], check=True)
        found = {line for _, line, _, _, _ in check_listing(lst)}
    wanted = {n for n, text in enumerate(open(src, encoding='utf-8'), 1) if '; SLIP' in text}
    if found != wanted:
        print('check-286 self-test FAILED: missed lines %s, wrongly flagged %s'
              % (sorted(wanted - found), sorted(found - wanted)))
        return 1
    with tempfile.TemporaryDirectory() as tmp:
        dis = os.path.join(tmp, 'slips.dis')
        with open(dis, 'w') as f:
            f.write(DIS_SELF_TEST)
        found = sorted(line for _, line, _, _, _ in check_disassembly(dis))
    if found != [2, 3, 4, 7, 11, 12, 13]:
        print('check-286 self-test FAILED: the C checks flagged lines %s, not 2, 3, 4, 7, 11, '
              '12, 13' % found)
        return 1
    print('check-286 self-test: all %d slips found, nothing else; the C checks too'
          % len(wanted))
    return 0


def main(args):
    if args == ['--self-test']:
        return self_test()
    if not args:
        print('check-286: no listing given')
        return 1
    problems = []
    for path in args:
        problems += check_disassembly(path) if path.endswith('.dis') else check_listing(path)
    for path, line, addr, reason, source in problems:
        print('%s:%d: %s at %s: %s' % (path, line, reason, addr, source))
    if problems:
        print('check-286: %d instruction(s) a 286 cannot run' % len(problems))
        return 1
    print('check-286: %d listing(s) and disassemblies, only 286 instructions' % len(args))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
