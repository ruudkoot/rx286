#!/usr/bin/env python3
# ============================================================================
# rx286 - tools/run-test
# Builds a test image for every test, boots it in Bochs without a window and
# compares what COM1 shows with what the test expects.
#
#   tools/run-test                    every tests/*/*.test
#   tools/run-test tests/shell/echo.test ...
#   tools/run-test --jobs 4 --verbose
#
# A test file is a header, a line `---`, and the expected transcript:
#
#   program: idle               idle (default: waits for keys), shell, syscalls,
#                               attack or fuzz
#   keys: echo hi\n             a key script (tools/rxlib.py); may repeat
#   define: TEST_PANIC_DIVIDE   a NASM define for the kernel; may repeat
#   image: fragmented           change the floppy: fragmented, missing, oversized,
#                               truncated (a sector short), noloader (sectors
#                               1-3 zeroed)
#   timeout: 30                 seconds of wall time (default 30)
#   match: full                 full (default), prefix or contains
#   break: syscall              a debugger breakpoint, by kernel symbol...
#   debugger: info gdt 0 11     ...and commands to run there; may repeat
#   emulators: bochs dosbox-x   where the test applies (default: all)
#   media: B ejected            change a drive: B ejected, B protected, D absent;
#                               may repeat
#   lpt1: text                  a line LPT1 must have printed; may repeat (the
#                               whole of what it printed, in order); lpt2 too
#   sector: B 700 text          after the run, sector 700 of drive B (A, B, C
#                               or D) must start with text; may repeat
#   ---
#   expected lines; {name} is a program symbol's offset, {k:name} a kernel one
#   (four hex digits); {x:name}, {kx:name} the same as eight lower-case digits;
#   {image_sum} entry.asm's Fletcher sum of kernel.bin's words. A line that starts with
#   @bochs, @dosbox-x or @mame counts on that emulator only: where they
#   differ (docs/emulators.md).
#
# --emulator chooses Bochs (the default), DOSBox-X's 286 or MAME's IBM PC/AT
# (roadmap M9).
#
# full:     the transcript is exactly the expected lines, then `TEST END`.
# prefix:   the transcript starts with the expected lines (the run stops then).
# contains: the expected lines appear in this order, among the transcript's
#           and the debugger's lines, and the test ends (TEST END, or the
#           debugger's quit). A timeout always fails.
# Lines the kernel marks `[trace]`, register lines (`regs:`) and blank lines
# are ignored. docs/testing.md
# explains the layers of tests.
# ============================================================================

import argparse
import concurrent.futures
import glob
import os
import re
import shutil
import subprocess
import sys
import time

import rxlib

ROOT = rxlib.ROOT
IGNORED_PREFIXES = ('[trace]', 'regs:')
# The image of each drive in a test's directory (`sector:`).
DRIVE_IMAGES = {'A': 'run.img', 'B': 'disks/fdb.img', 'C': 'disks/hd0.img',
                'D': 'disks/hd1.img'}
SECTOR_SIZE = rxlib.LAYOUT['SECTOR_SIZE']
EMULATORS = ('bochs', 'dosbox-x', 'mame')
# A test's timeout is written for Bochs; the others boot slower (MAME runs
# IBM's power-on test, about 6 s alone) and are heavier to run side by side.
TIMEOUT_SCALE = {'bochs': 1, 'dosbox-x': 2, 'mame': 4}
JOBS_DIVISOR = {'bochs': 1, 'dosbox-x': 2, 'mame': 3}
EMULATOR = 'bochs'                  # set from --emulator


class Test:
    def __init__(self, path):
        self.path = os.path.relpath(path, ROOT)
        self.suite = os.path.basename(os.path.dirname(path))
        self.name = os.path.splitext(os.path.basename(path))[0]
        self.program = 'idle'
        self.keys = ''
        self.defines = []
        self.image = None
        self.timeout = 30.0
        self.match = 'full'
        self.breakpoint = None
        self.debugger = []
        self.emulators = list(EMULATORS)
        self.media = []
        self.printed = {}                   # 'lpt1' -> the lines it must print
        self.sectors = []                   # (drive, sector, text)
        self.expected = []
        self.parse(open(path, encoding='utf-8').read())

    def parse(self, text):
        if '\n---\n' not in '\n' + text:
            raise ValueError('%s: no line ---' % self.path)
        header, _, body = ('\n' + text).partition('\n---\n')
        for line in header.splitlines():
            if not line.strip() or line.lstrip().startswith('#'):
                continue
            key, sep, value = line.partition(':')
            if not sep:
                raise ValueError('%s: bad header line %r' % (self.path, line))
            key, value = key.strip(), value.strip()
            if key == 'program':
                self.program = value
            elif key == 'keys':
                self.keys += value
            elif key == 'define':
                self.defines.append(value)
            elif key == 'image':
                self.image = value
            elif key == 'timeout':
                self.timeout = float(value)
            elif key == 'match':
                self.match = value
            elif key == 'break':
                self.breakpoint = value
            elif key == 'debugger':
                self.debugger.append(value)
            elif key == 'emulators':
                self.emulators = value.split()
                for e in self.emulators:
                    if e not in EMULATORS:
                        raise ValueError('%s: unknown emulator %r' % (self.path, e))
            elif key == 'media':
                if value not in rxlib.MEDIA:
                    raise ValueError('%s: unknown media change %r' % (self.path, value))
                self.media.append(value)
            elif key in ('lpt1', 'lpt2'):
                self.printed.setdefault(key, []).append(line.partition(':')[2].strip())
            elif key == 'sector':
                drive, number, text = (value.split(None, 2) + [''])[:3]
                if drive not in DRIVE_IMAGES or not number.isdigit() or not text:
                    raise ValueError('%s: bad sector line %r' % (self.path, line))
                self.sectors.append((drive, int(number), text))
            else:
                raise ValueError('%s: unknown header %r' % (self.path, key))
        self.expected = body.rstrip('\n').split('\n') if body.strip() else []
        if self.debugger:
            self.match = 'contains'

    @property
    def build_dir(self):
        # MAME's images differ (TEST_TYPE_DIRECT), so they are built apart.
        tests = 'tests-mame' if EMULATOR == 'mame' else 'tests'
        return os.path.join(ROOT, 'build', tests, '%s-%s' % (self.suite, self.name))


def build(test):
    """Build the test's image; returns an error message or None."""
    b = test.build_dir
    os.makedirs(b, exist_ok=True)
    keys_inc = os.path.join(b, 'test-keys.inc')
    text = rxlib.keys_include(test.keys)
    if not os.path.exists(keys_inc) or open(keys_inc, encoding='utf-8').read() != text:
        with open(keys_inc, 'w', encoding='utf-8') as f:
            f.write(text)
    # The defines are part of the build too: a change of them rebuilds.
    stamp = os.path.join(b, 'defines.txt')
    wanted = repr((test.program, test.defines, EMULATOR == 'mame'))
    if not os.path.exists(stamp) or open(stamp, encoding='utf-8').read() != wanted:
        for name in ('kernel.bin', 'user.bin'):
            if os.path.exists(os.path.join(b, name)):
                os.remove(os.path.join(b, name))
        with open(stamp, 'w', encoding='utf-8') as f:
            f.write(wanted)
    defines = ["-dTEST_KEYS_INC='\"%s\"'" % keys_inc]
    if test.program == 'fuzz':
        defines.append('-dTEST_FUZZ')
    if test.program == 'attack':
        defines.append('-dTEST_ATTACK')
    defines += ['-d' + d for d in test.defines]
    if EMULATOR == 'mame':
        defines.append('-dTEST_TYPE_DIRECT')    # IBM's 8042 firmware has no D2h
    cmd = ['make', '--no-print-directory', '-C', ROOT, 'FLAVOUR=test', 'B=' + b,
           'PROGRAM=' + test.program, 'TEST_DEFINES=' + ' '.join(defines),
           'TEST_KEYS_FILE=' + keys_inc,
           'image', 'symbols']
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        errors = [l for l in (result.stdout + result.stderr).splitlines()
                  if 'error' in l.lower() or 'warning' in l.lower()]
        return 'build failed:\n' + '\n'.join(errors[-20:])
    # The run boots a copy, so changing it leaves the build's image as make made it.
    shutil.copyfile(os.path.join(b, 'rx286.img'), os.path.join(b, 'run.img'))
    if test.image:
        return change_image(test, os.path.join(b, 'run.img'))
    return None


def mtools(*args):
    env = dict(os.environ, MTOOLS_SKIP_CHECK='1', SOURCE_DATE_EPOCH='599616000')
    return subprocess.run(list(args), capture_output=True, text=True, env=env)


def change_image(test, image):
    """The boot tests' floppies: a fragmented, missing or oversized kernel."""
    kernel = os.path.join(test.build_dir, 'kernel.bin')
    filler = os.path.join(test.build_dir, 'filler.bin')
    if test.image == 'noloader':
        with open(image, 'r+b') as f:
            f.seek(512)
            f.write(bytes(512 * rxlib.LAYOUT['LOADER_SECTORS']))
        return None
    if test.image == 'missing':
        r = mtools('mdel', '-i', image, '::KERNEL.BIN')
    elif test.image == 'truncated':
        short = os.path.join(test.build_dir, 'short.bin')
        with open(short, 'wb') as f:
            f.write(open(kernel, 'rb').read()[:-512])
        r = mtools('mdel', '-i', image, '::KERNEL.BIN')
        if r.returncode == 0:
            r = mtools('mcopy', '-i', image, short, '::KERNEL.BIN')
    elif test.image == 'oversized':
        big = os.path.join(test.build_dir, 'big.bin')
        with open(big, 'wb') as f:
            f.write(open(kernel, 'rb').read() + bytes(4096))
        r = mtools('mdel', '-i', image, '::KERNEL.BIN')
        if r.returncode == 0:
            r = mtools('mcopy', '-i', image, big, '::KERNEL.BIN')
    elif test.image == 'fragmented':
        # Interleave small files with the kernel's clusters, then free them.
        r = mtools('mdel', '-i', image, '::KERNEL.BIN')
        with open(filler, 'wb') as f:
            f.write(bytes(512))
        for i in range(20):
            mtools('mcopy', '-i', image, filler, '::F%02d.TMP' % i)
        for i in range(0, 20, 2):
            mtools('mdel', '-i', image, '::F%02d.TMP' % i)
        r = mtools('mcopy', '-i', image, kernel, '::KERNEL.BIN')
        fat = mtools('mshowfat', '-i', image, '::KERNEL.BIN').stdout
        if fat.count('<') < 2:
            return 'the fragmented image is not fragmented: ' + fat
    else:
        return 'unknown image change %r' % test.image
    if r.returncode != 0:
        return 'mtools failed: ' + r.stderr
    return None


def substitute(test, line):
    """{name} (the program's) and {k:name} (the kernel's) to four upper-case
    hex digits; {x:name} and {kx:name} to eight lower-case ones, as Bochs'
    debugger prints them."""
    def lookup(m):
        which, name = m.group(1) or '', m.group(2)
        if name == 'image_sum':     # entry.asm's Fletcher sum of kernel.bin's words
            data = open(os.path.join(test.build_dir, 'kernel.bin'), 'rb').read()
            plain = weighted = 0
            for i in range(0, len(data) - 1, 2):
                plain = (plain + (data[i] | data[i + 1] << 8)) & 0xFFFF
                weighted = (weighted + plain) & 0xFFFF
            return '%04X' % weighted
        mapfile = 'kernel.map' if which.startswith('k') else 'user.map'
        symbols = rxlib.symbol_offsets(os.path.join(test.build_dir, mapfile))
        if name not in symbols:
            raise KeyError('%s: no symbol %s in %s' % (test.path, name, mapfile))
        return ('%08x' if 'x' in which else '%04X') % symbols[name]
    return re.sub(r'\{(k:|kx:|x:)?([A-Za-z_.][A-Za-z0-9_.]*)\}', lookup, line)


def relevant(lines):
    """The lines a test compares: not the kernel's trace and register lines,
    and not blank ones."""
    return [l for l in lines if l and not l.startswith(IGNORED_PREFIXES)]


def for_emulator(lines):
    """The expected lines that count on this emulator, without their tags."""
    out = []
    for line in lines:
        if line.startswith('@'):
            tag, _, rest = line.partition(' ')
            if tag[1:] not in EMULATORS:
                raise ValueError('unknown emulator tag %s in %r' % (tag, line))
            if tag[1:] != EMULATOR:
                continue
            line = rest
        out.append(line)
    return out


def compare(test, transcript, debugger_lines):
    """Returns None if the test passes, else a description of the failure."""
    expected = [substitute(test, l) for l in for_emulator(test.expected) if l]
    got = relevant(transcript)
    if any(l.startswith('PANIC') or 'rx286 PANIC' in l for l in got) and \
            not any('PANIC' in l for l in expected):
        return 'the kernel panicked'
    if test.match == 'full':
        if not got or got[-1] != 'TEST END':
            return 'no TEST END'
        got = got[:-1]
        if got != expected:
            return diff(expected, got)
    elif test.match == 'prefix':
        if got[:len(expected)] != expected:
            return diff(expected, got[:len(expected) + 5])
    elif test.match == 'contains':
        if not test.debugger and 'TEST END' not in got:
            return 'no TEST END'
        pool = got + debugger_lines
        i = 0
        for line in pool:
            if i < len(expected) and expected[i] in line:
                i += 1
        if i < len(expected):
            return 'not found, in order: %r' % expected[i]
    else:
        return 'unknown match %r' % test.match
    return None


def check_printers(test, printers):
    """What LPT1 and LPT2 printed, against the test's lpt1: and lpt2: lines."""
    for name, path in zip(('lpt1', 'lpt2'), printers):
        if name not in test.printed:
            continue
        raw = open(path, 'rb').read() if os.path.exists(path) else b''
        got = [l.rstrip() for l in raw.decode('latin-1').replace('\r', '').split('\n')]
        while got and not got[-1]:
            got.pop()
        if got != test.printed[name]:
            lines = diff(test.printed[name], got).split('\n', 1)[1]
            return '%s printed otherwise (expected | got):\n%s' % (name, lines)
    return None


def check_sectors(test):
    """Each sector: line against the drive's image after the run."""
    for drive, number, text in test.sectors:
        path = os.path.join(test.build_dir, DRIVE_IMAGES[drive])
        with open(path, 'rb') as f:
            f.seek(number * SECTOR_SIZE)
            data = f.read(len(text))
        if data != text.encode('latin-1'):
            return 'sector %d of drive %s starts %r, not %r' % (number, drive, data, text)
    return None


def diff(expected, got):
    out = []
    for k in range(max(len(expected), len(got))):
        e = expected[k] if k < len(expected) else '<none>'
        g = got[k] if k < len(got) else '<none>'
        mark = '  ' if e == g else '!!'
        out.append('%s %-50s | %s' % (mark, e[:50], g))
    return 'transcript differs (expected | got):\n' + '\n'.join(out)


def run(test):
    started = time.monotonic()
    error = build(test)
    if error:
        return test, error, time.monotonic() - started
    b = test.build_dir
    serial = os.path.join(b, 'com1.log' if EMULATOR == 'bochs' else 'com1-%s.log' % EMULATOR)
    dbglog = os.path.join(b, 'debugger.log')
    for f in (serial, dbglog):
        if os.path.exists(f):
            os.remove(f)
    printers = [os.path.join(b, '%s.out' % p) for p in ('lpt1', 'lpt2')]
    for f in printers:
        if os.path.exists(f):
            os.remove(f)
    bochsrc = os.path.join(b, 'test.bochsrc')
    disks = rxlib.private_disks(os.path.join(b, 'disks'))
    rxlib.write_bochsrc(bochsrc, image=os.path.join(b, 'run.img'), serial=serial,
                        log=os.path.join(b, 'bochs.log'),
                        display=rxlib.DISPLAY_HEADLESS, debugger_log=dbglog,
                        disks=disks, printers=printers, media=test.media)
    rc = []
    if test.breakpoint:
        rc.append('ldsym global "%s"' % os.path.join(b, 'rx286.sym'))
        rc.append('lb "%s"' % test.breakpoint)
        rc.append('c')
        rc += test.debugger
        rc.append('quit')
    else:
        rc.append('c')

    wanted = [substitute(test, l) for l in for_emulator(test.expected) if l]
    timeout = test.timeout * TIMEOUT_SCALE[EMULATOR]

    def until(lines):
        got = relevant(lines)
        if test.match == 'prefix':
            return got[:len(wanted)] == wanted
        return 'TEST END' in got
    if EMULATOR == 'bochs':
        status, _ = rxlib.run_bochs(bochsrc, rc, timeout, until=until, serial=serial,
                                    log=os.path.join(b, 'bochs.log'), disks=disks)
    elif EMULATOR == 'dosbox-x':
        status, _ = rxlib.run_dosbox(b, os.path.join(b, 'run.img'), serial, timeout, until,
                                     printers=printers)
    else:
        status, _ = rxlib.run_mame(b, os.path.join(b, 'run.img'), serial, timeout, until,
                                   disks=disks)
    transcript = rxlib.normalise_transcript(open(serial, 'rb').read()) \
        if os.path.exists(serial) else []
    debugger_lines = open(dbglog, encoding='latin-1').read().splitlines() \
        if os.path.exists(dbglog) else []
    error = compare(test, transcript, debugger_lines) or check_printers(test, printers) \
        or check_sectors(test)
    if status == 'timeout':
        error = 'timed out after %.0f s; %s' % (timeout, error or 'the transcript matched')
    return test, error, time.monotonic() - started


def main():
    parser = argparse.ArgumentParser(description='Run rx286 tests in Bochs.')
    parser.add_argument('tests', nargs='*')
    parser.add_argument('--jobs', type=int, default=0, help='default: CPUs (fewer for MAME)')
    parser.add_argument('--verbose', action='store_true')
    parser.add_argument('--emulator', choices=EMULATORS, default='bochs')
    args = parser.parse_args()
    global EMULATOR
    EMULATOR = args.emulator
    if not args.jobs:
        args.jobs = max(2, (os.cpu_count() or 2) // JOBS_DIVISOR[EMULATOR])
    paths = args.tests or sorted(glob.glob(os.path.join(ROOT, 'tests', '*', '*.test')))
    if not paths:
        print('run-test: no tests')
        return 1
    if not os.path.exists(os.path.join(rxlib.DISKS, 'fdb.img')):
        subprocess.run(['make', '--no-print-directory', '-C', ROOT, 'disks'], check=True,
                       capture_output=True)
    tests = [Test(os.path.abspath(p)) for p in paths]
    skipped = [t for t in tests if EMULATOR not in t.emulators]
    tests = [t for t in tests if EMULATOR in t.emulators]
    for t in skipped:
        print('SKIP  %-40s (not on %s)' % (t.path, EMULATOR))
    failures = 0
    with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as pool:
        for test, error, seconds in pool.map(run, tests):
            status = 'PASS' if error is None else 'FAIL'
            print('%s  %-40s %5.1f s' % (status, test.path, seconds))
            if error:
                failures += 1
                print('      ' + error.replace('\n', '\n      '))
                print('      (transcript: %s)' % os.path.relpath(
                    os.path.join(test.build_dir, 'com1.log'), ROOT))
    print('run-test: %d of %d passed on %s' % (len(tests) - failures, len(tests), EMULATOR))
    return 1 if failures else 0


if __name__ == '__main__':
    sys.exit(main())
