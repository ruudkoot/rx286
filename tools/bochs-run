#!/usr/bin/env python3
# ============================================================================
# rx286 - tools/bochs-run
# Runs Bochs on a build's image, with a window: `make run` and `make debugger`.
#
#   --mode run        start at once
#   --mode debugger   load the symbols and stop at the kernel's entry
# The log (COM2) is <build>/com2.log, Bochs' log <build>/bochs.log and the
# debugger's <build>/debugger.log; what LPT1 and LPT2 print goes to
# <build>/lpt1.txt and <build>/lpt2.txt. Drives B, C and D are
# build/run-disks/, copies of build/disks/ (make disks) the Makefile makes,
# which the shell may write to; the tests copy build/disks/, which only
# tools/mkdisks writes. The window is Bochs' X11
# display if the package bochs-x is installed, else SDL2 (bochs-sdl), else
# wx (bochs-wx).
# ============================================================================

import argparse
import glob
import os
import subprocess
import sys

import rxlib


def clear_stale_locks():
    """Bochs locks its disk images with <image>.lock and leaves the lock
    behind when it is stopped with Ctrl-C; with no Bochs running (Debian's
    is bochs-bin behind a script, others bochs), every lock in
    build/run-disks is stale."""
    for pid in os.listdir('/proc'):
        try:
            with open('/proc/%s/comm' % pid) as f:
                if f.read().strip() in ('bochs-bin', 'bochs'):
                    return
        except (OSError, ValueError):
            continue
    for lock in glob.glob(os.path.join(rxlib.RUN_DISKS, '*.lock')):
        os.remove(lock)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--mode', choices=['run', 'debugger'], required=True)
    parser.add_argument('--build', default='build/debug')
    parser.add_argument('--release', action='store_true',
                        help='a release build: no log, COM2 the modem (attached to nothing)')
    args = parser.parse_args()
    build = os.path.abspath(args.build)
    clear_stale_locks()
    bochsrc = os.path.join(build, args.mode + '.bochsrc')
    rxlib.write_bochsrc(bochsrc,
                        image=os.path.join(build, 'rx286.img'),
                        serial=os.path.join(build, 'com2.log'),
                        log_port=None if args.release else 'com2',
                        log=os.path.join(build, 'bochs.log'),
                        display=rxlib.window_display(),
                        debugger_log=os.path.join(build, 'debugger.log'),
                        magic=(args.mode == 'debugger'), disks=rxlib.RUN_DISKS,
                        printers=(os.path.join(build, 'lpt1.txt'),
                                  os.path.join(build, 'lpt2.txt')))
    rc = bochsrc + '.rc'
    with open(rc, 'w', encoding='utf-8') as f:
        if args.mode == 'run':
            f.write('c\n')
        else:
            f.write('ldsym global "%s"\n' % os.path.join(build, 'rx286.sym'))
            f.write('lb 0x%x\n' % rxlib.LAYOUT['KERNEL_PHYS'])
            f.write('c\n')
    return subprocess.call(['bochs', '-q', '-f', bochsrc, '-rc', rc])


if __name__ == '__main__':
    sys.exit(main())
